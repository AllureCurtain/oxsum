/target
.env

# The self-hosted deployment's own env file (live rail + database secrets):
# deploy/operator.env.example is the template, the copy is never committed.
deploy/.env

# git worktrees: one per PR, created under .worktrees/, never committed
.worktrees/

# Local working notes (product-direction, references, e2e scripts, logs) —
# kept out of the tree by .git/info/exclude already; this makes it durable
# across clones so a stray `git add -A` can't sweep them in.
local-notes/

# infra/hyperswitch/.repo — the hyperswitch clone the migration_runner mounts.
infra/hyperswitch/.repo/

# macOS Finder metadata
.DS_Store
