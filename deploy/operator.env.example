# Operator configuration for a self-hosted oxsum deployment (issue #619).
#
# Copy this file to `deploy/.env` (beside the compose files — env_file paths
# resolve against the compose file's directory), fill every line that
# applies, then run `scripts/check-secrets.sh deploy/.env` and
# `scripts/check-config.sh deploy/.env` before `docker compose up`.
#
# `.env.example` documents every variable the server reads; this file is the
# shorter list an *operator* sets for the core+payment compose profiles —
# deployment shape first, secrets second, rails last. Variables not listed
# here keep their documented defaults.

# ---------------------------------------------------------------- deployment

# The exact immutable reference from the verified promotion receipt.
# Both migration and serving use it. No image/tag is selected by default.
# Replace the placeholder digest before starting Compose.
OXSUM_IMAGE_REF=ghcr.io/allurecurtain/oxsum@sha256:<64-character-registry-digest>

# What the server binds. The default publishes on loopback only; put a
# reverse proxy (with TLS) in front for real traffic, or set OXSUM_BIND=0.0.0.0
# on a private network.
OXSUM_BIND=127.0.0.1
OXSUM_PORT=3000

# The deployment's public origin — the base URL mailed links, OAuth callbacks
# and checkout redirects are built on. Required as soon as the mailer, an
# OAuth client or a payment rail is configured.
# OXSUM_PUBLIC_URL=https://wallet.example.com

# Session cookies over plain http are what makes this default work locally;
# a deployment behind TLS must set true or browsers drop the cookie.
OXSUM_SESSION_COOKIE_SECURE=false

# -------------------------------------------------------------- the business

# What the first `POST /api/v1/business/setup/register` call names — the
# runbook (docs/self-hosted-install.md) substitutes these into the request.
# They are operator intent carried by the runbook, not server configuration:
# the server reads the business name from the request itself.
OXSUM_BUSINESS_NAME=Example Wallet Co.
# The slug is what the setup checklist prints back; pick the hostname-safe
# short form.
OXSUM_BUSINESS_SLUG=example-wallet

# Which deposit rails this deployment activates. Empty — the default — means
# "whatever is configured"; the startup check fails the boot when the list and
# the configured credentials disagree either way (a declared rail with no
# credentials, or credentials no declaration names). Valid entries:
# stripe, airwallex, hyperswitch, x402, solana — comma-separated.
# OXSUM_RAILS=stripe

# Whether customers may register themselves once the business enables open
# registration. `true` requires the mailer block below — the boot refuses a
# deployment that could never send its verification mail. Unset declares
# nothing; the business's own registration policy (set over the API after
# setup) is what actually opens or closes signup.
# OXSUM_CUSTOMER_SELF_REGISTER=false

# Demo data. Unset or false: a fresh `docker compose up` produces an empty
# production deployment. `true` is the only way `docker compose run --rm
# oxsum seed` writes the demo world, and it still refuses a database that
# already holds organizations. Never set this on a deployment you mean to run.
# OXSUM_DEMO_SEED=false

# ------------------------------------------------------------------ database

# The PostgreSQL the compose `postgres` service runs and the server connects
# to. POSTGRES_PASSWORD is the only database credential; DATABASE_URL is
# composed from these by the compose file — a deployment with its own
# PostgreSQL sets DATABASE_URL in .env directly and leaves the service off.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
POSTGRES_DB=oxsum

# The process's whole connection budget (every tenant shares the one pool;
# docs/decisions.md). Twice the expected concurrent gateway requests, floor 10.
OXSUM_DB_MAX_CONNECTIONS=20

# ------------------------------------------------------------------- secrets

# Never commit real values. `scripts/check-secrets.sh .env` lints for
# placeholders and loose permissions before a boot.

# 32 bytes, base64 — seals the upstream/rail credentials stored in the
# database. Required as soon as a channel exists. Losing it strands every
# sealed credential. Generate: openssl rand -base64 32
# OXSUM_SECRET_KEY=

# The operator token on /api/v1/admin and /metrics — at least 16 characters.
# Generate: openssl rand -hex 32
# OXSUM_ADMIN_TOKEN=

# 32 bytes, base64 — the Ed25519 seed the transparency-log head signatures are
# drawn from. Optional; unset runs the log unsigned (the /api/v1/log endpoints
# answer 503). Generate: openssl rand -base64 32
# OXSUM_HEAD_SIGNING_KEY=

# -------------------------------------------------------------------- mailer

# All three or none — a subset refuses to boot. Required for
# OXSUM_CUSTOMER_SELF_REGISTER=true, invitations and password resets.
# OXSUM_SMTP_URL=smtps://user:pass@smtp.example.com:465
# OXSUM_MAIL_FROM=wallet@example.com

# --------------------------------------------------------------------- rails

# Each rail is an all-or-nothing set — a half-set refuses to boot with the
# missing variable named. All of them need OXSUM_PUBLIC_URL.
#
#   stripe:       OXSUM_STRIPE_SECRET_KEY, OXSUM_STRIPE_WEBHOOK_SECRET
#   airwallex:    OXSUM_AIRWALLEX_CLIENT_ID, OXSUM_AIRWALLEX_API_KEY,
#                 OXSUM_AIRWALLEX_WEBHOOK_SECRET
#   hyperswitch:  OXSUM_HYPERSWITCH_API_KEY, OXSUM_HYPERSWITCH_WEBHOOK_SECRET,
#                 OXSUM_HYPERSWITCH_PUBLISHABLE_KEY
#   x402:         OXSUM_X402_FACILITATOR_URL, OXSUM_X402_NETWORK,
#                 OXSUM_X402_ASSET, OXSUM_X402_PAY_TO — or the stand-in
#                 OXSUM_X402_VERIFYING_KEY for a test deployment
#   solana:       OXSUM_SOLANA_RPC_URL, OXSUM_SOLANA_PAY_TO — the top-up rail
#                 (issues #1117, #1140); a `sol` whitelist intent is
#                 oracle-priced at open via Pyth Hermes (issue #1139 —
#                 OXSUM_SOLANA_PYTH_URL / _FEED_ID / _MAX_AGE_SECS /
#                 _MAX_CONF_RATIO tune it; all have defaults).
#                 OXSUM_SOLANA_RATE_MICRO is the devnet stand-in and reads
#                 only behind OXSUM_SOLANA_DEVNET_STATIC_RATE=1 on a `sol`
#                 whitelist entry (required whenever the legacy
#                 SPL_TOKEN_MINT form is set — the legacy asset locks the
#                 static figure unconditionally), refused beside a `sol`
#                 whitelist entry without the flag. OXSUM_SOLANA_ASSETS is
#                 the mint whitelist (sol,usdc — order is display order);
#                 every non-sol key needs OXSUM_SOLANA_MINT_<KEY>, and the
#                 boot reads each mint's decimals and owner program on-chain,
#                 refusing a Token-2022 mint. OXSUM_SOLANA_DEFAULT_ASSET picks
#                 what an asset-less open resolves (recommended usdc on
#                 mainnet; unset defaults to the first SPL entry, else sol).
#                 OXSUM_SOLANA_MINT_USDT is the reserved #1152 slot. The
#                 legacy OXSUM_SOLANA_SPL_TOKEN_MINT + _DECIMALS form still
#                 parses for existing single-mint configs. _COMMITMENT /
#                 _INTENT_TTL_SECS optional; COMMITMENT defaults to
#                 finalized (mainnet-grade), set confirmed for a devnet loop.
#                 OXSUM_SOLANA_MIN_MINOR / _MAX_MINOR bound a single intent's
#                 credit amount; OXSUM_SOLANA_OPENS_PER_MINUTE caps how many
#                 intents one organization opens per minute (0 = unbounded).
#                 OXSUM_SOLANA_MULTISIG_ACCOUNT pins custody (issue #1143): set
#                 it to the Squads v4 multisig account and the boot proves
#                 PAY_TO is that multisig's vault index 0 — a mismatch refuses
#                 to start. Unset warns that PAY_TO is an unverified hot
#                 wallet. See docs/self-hosted-solana-multisig.md.
#
# The merchant-identity bootstrap per configured rail:
#   OXSUM_<RAIL>_MERCHANT_ACCOUNT_ID + OXSUM_<RAIL>_MERCHANT_MODE=test|live
# See .env.example for the full commented set.
