{
  "name": "verify-oxsum-bill",
  "version": "0.1.0",
  "description": "Verify oxsum bills, statements and usage reports entirely in the browser — recomputes entry hashes, links them to the ledger head, and refolds each committed subset, with no server round-trip.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify-bill": {
      "types": "./dist/verify-bill.d.ts",
      "import": "./dist/verify-bill.js"
    },
    "./verify-statement": {
      "types": "./dist/verify-statement.d.ts",
      "import": "./dist/verify-statement.js"
    },
    "./verify-usage-report": {
      "types": "./dist/verify-usage-report.d.ts",
      "import": "./dist/verify-usage-report.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "verification",
    "billing",
    "merkle",
    "proof",
    "oxsum",
    "wasm"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllureCurtain/oxsum.git",
    "directory": "web/verify-sdk"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
