# PostgreSQL connection string. Each tenant gets its own schema (ledger_<tenant>) in this database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/oxsum

# Test-only knob: points doubleentry's Postgres suite (`cargo test -p doubleentry
# --features postgres --test postgres`) at this server instead of a testcontainers
# container, for developers who run PostgreSQL without Docker. Falls back to
# DATABASE_URL when only that is set; neither set keeps the container default.
# DOUBLEENTRY_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Maximum size of the one pool every tenant shares. Each PostgreSQL connection is a backend
# process, so this is the process's whole connection budget rather than a per-tenant
# allowance: it does not grow with the number of tenants. The pool serves request handlers
# and the jobs worker together, and one gateway turn draws several connections in short
# bursts at admission and settle — a rule of thumb is twice the expected number of
# concurrent gateway requests, floor 10. Saturation answers 429 POOL_BUSY with Retry-After.
OXSUM_DB_MAX_CONNECTIONS=20

# Whether this deployment accepts self-registration: invite (default) or open. With invite,
# POST /api/v1/auth/register answers 403 and an invitation link is the way in.
OXSUM_SIGNUP=invite

# Credits a new organization's wallet starts with, in minor units (1 credit = 1_000_000).
# Default 0 — registration then writes no ledger entry at all. Only self-registration
# grants it: an invitation's redeem joins an existing organization and credits nothing.
# OXSUM_SIGNUP_BONUS_MINOR=0

# Address the server listens on.
OXSUM_ADDR=127.0.0.1:3000

# The bootstrap channel for a database that has none; after the first start, channels and their
# prices live in the database and are managed over /api/v1/admin. All three are set together, or
# none of them: with none and an empty database, the deployment serves the wallet alone and
# GET /v1/models is empty. The base URL is what a provider publishes, usually ending in /v1;
# /chat/completions is appended to it.
# OXSUM_UPSTREAM_BASE_URL=https://api.deepseek.com/v1
# OXSUM_UPSTREAM_API_KEY=sk-...
# The channel's name, reported as `owned_by` in /v1/models. Default: upstream.
# OXSUM_UPSTREAM_NAME=deepseek
# The models this channel serves, and what each costs in minor units per million tokens
# (1 credit = 1_000_000). maxOutputTokens is the ceiling for a request that asks for none, and the
# freeze is computed from it, so it must be the model's real limit rather than a safe guess.
# OXSUM_MODELS={"deepseek-chat":{"inputPricePerMillion":270000,"outputPricePerMillion":1100000,"maxOutputTokens":8192}}

# 32 bytes, base64, sealing the upstream credentials stored in the database (AES-256-GCM). Required
# as soon as a channel exists — including one seeded from the variables above. Generate one with:
#   openssl rand -base64 32
# The server refuses to start when it cannot open a stored credential. Losing this key means
# re-entering every upstream credential, because the stored ones are unreadable without it.
# OXSUM_SECRET_KEY=

# 32 bytes, base64: the seed of the Ed25519 key the operator signs tree heads with
# (the /api/v1/log endpoints). Optional — unset means those endpoints answer 503 and the
# wallet is served without them. Generate one with:
#   openssl rand -base64 32
# Rotating is restarting with a new seed: heads are signed on demand, so nothing is stored
# to migrate; signatures made under the old seed stop verifying.
# OXSUM_HEAD_SIGNING_KEY=

# Comma-separated base URLs of external C2SP `tlog-witness` endpoints the hourly
# `witness-checkpoints` pass publishes each organization's signed head to
# (/add-checkpoint, issue #231). The cosigned notes they answer land in
# `oxsum.witness_cosignatures` and are served at `GET /api/v1/log/checkpoint`.
# Requires OXSUM_HEAD_SIGNING_KEY; unset or empty runs no anchoring and the
# endpoint answers `data: null`. Example: http://witness.internal:8100
# OXSUM_WITNESS_URLS=

# The deployment's pinned witness keyset, served on /api/v1/log/checkpoint as
# `witnessKeys` (issue #259) so a reader can verify each cosignature line
# itself. A JSON array, one entry per witness in OXSUM_WITNESS_URLS:
#   [{"url":"http://witness.internal:8100","keyName":"w1",
#     "publicKey":"<64 hex>","keyHash":"<8 hex>"}]
# `keyHash` is the witness's cosignature/v1 key-hash selector — it must equal
# SHA-256(keyName || '\n' || 0x04 || publicKey)'s first four bytes, and a
# mismatch refuses to boot. Unset or empty serves the cosigned notes with no
# pins; a verifier holding its own pinset can still check them.
# OXSUM_WITNESS_KEYS=

# This deployment's own tlog-witness (issue #260): POST /add-checkpoint answers
# foreign logs' checkpoint submissions, cosigning each head that extends the one
# this witness last vouched for and refusing every other. All three together, or
# none — a subset is a startup error, because a witness that signs without being
# told whom to trust has already been made to forget a fork.
# OXSUM_WITNESS_SIGNING_KEY is 32 bytes, base64: the seed of the Ed25519 key the
#   witness cosigns under. Generate one with: openssl rand -base64 32
# OXSUM_WITNESS_KEY_NAME is the name the cosignature/v1 line carries — the
#   submitter's verify step looks it up by name. Default: oxsum/witness
# OXSUM_WITNESS_TRUST is required once the signing key is set: comma-separated
#   origin=size:root_b64 pins naming every log this witness vouches for and the
#   head it starts from. A log's operator hands its origin and current signed
#   head out of band, and they are pinned here — there is no trust-on-first-use,
#   because a witness that accepts whatever arrives first could already be
#   signing a fork. Pinning size 0 onboards a brand-new log deliberately: the
#   first non-empty head it is offered is taken on trust (every log extends the
#   empty tree, so nothing is provable earlier), then it is a real witness.
#   Example:
#   OXSUM_WITNESS_TRUST="oxsum/ledgers/acme=3:Kioq…==,oxsum/ledgers/beta=0:AAAA…=="
# OXSUM_WITNESS_SIGNING_KEY=
# OXSUM_WITNESS_KEY_NAME=oxsum/witness
# OXSUM_WITNESS_TRUST=

# The platform admin's token for /api/v1/admin, at least 16 characters: it creates channels and
# appends price versions. Not an API key — it belongs to whoever deploys oxsum, not to an
# organization. Unset means no admin surface at all (those routes answer 401). Generate one with:
#   openssl rand -hex 24
# OXSUM_ADMIN_TOKEN=

# How long a gateway hold may sit unsettled before the background sweeper releases it at 0
# (settlement kind `swept`, recorded as an anomaly). A number of seconds with an optional s/m/h
# suffix; default 30m. Validated at startup: it must parse and be at least 60s. It must exceed the
# longest possible single request — anything older is abandoned by definition, so a hold that is
# old but whose request is still streaming cannot exist under a correct configuration.
OXSUM_HOLD_TIMEOUT=30m

# Whether the session cookie carries the `Secure` attribute: true or false (default false).
# A deployment behind TLS must set this to true, or browsers will not send the cookie back
# over https and may refuse to store it at all; false is what makes local http development work.
OXSUM_SESSION_COOKIE_SECURE=false

# Retention windows the daily `retention` job applies, in days (issue #166).
# OXSUM_RETENTION_PROVIDER_RAW_DAYS (default 7) bounds how long a usage row keeps
# `usage_details.provider_raw` — the raw upstream payload may carry prompt fragments,
# so this is the privacy window; the normalized columns stay forever.
# OXSUM_RETENTION_DELIVERIES_DAYS (default 30) bounds delivered/failed webhook
# deliveries; OXSUM_RETENTION_JOBS_DAYS (default 90) bounds finished job rows.
# Each must be a positive integer.
# OXSUM_RETENTION_PROVIDER_RAW_DAYS=7
# OXSUM_RETENTION_DELIVERIES_DAYS=30
# OXSUM_RETENTION_JOBS_DAYS=90

# Whether the daily `sync-upstream-prices` job probes each channel's live
# catalog for upstream-rate drift (issue #222): true or false (default false).
# It needs OXSUM_SECRET_KEY too — the probe unseals each channel's stored
# credential to authorize `GET {baseUrl}/api/v1/pricing` — so the job is
# scheduled only when both this flag and the sealing key are present.
# OXSUM_UPSTREAM_PRICE_SYNC=false

# Whether the daily `upstream-bill-sync` job reconciles each channel's
# provider-billed cost against the stored upstream estimate (issue #283):
# true or false (default false). It needs OXSUM_SECRET_KEY too — the pass
# unseals each channel's `bill_key_sealed` (a credential the admin channel
# write attaches with `billKey`) to authorize the provider's admin cost API —
# so the job is scheduled only when both this flag and the sealing key are
# present. A channel with no billing credential records a coverage-gap day,
# never a false zero.
# OXSUM_UPSTREAM_BILL_SYNC=false

# Outbound mail, for the verification and password-reset flows. All three variables together
# or none — a subset is a startup error, because a half-configured mailer only fails at send
# time, inside a request. Unset, the deployment sends no email: registration simply does not
# mail, forgot-password answers its indistinguishable OK, and the resend endpoint reports
# email is not configured (503).
# OXSUM_SMTP_URL is the lettre connection string: smtps://user:pass@host for implicit TLS,
# smtp://user:pass@host for STARTTLS-when-offered. The credentials live in the URL, so keep it
# out of logs the way OXSUM_SECRET_KEY is kept.
# OXSUM_SMTP_URL=smtps://user:pass@smtp.example.com
# OXSUM_MAIL_FROM=oxsum <noreply@example.com>
# The public base URL the mailed links point at — no trailing path.
# OXSUM_PUBLIC_URL=https://wallet.example.com

# GitHub OAuth login (all three together, or none): the OAuth app's client pair from
# https://github.com/settings/developers, and OXSUM_PUBLIC_URL again — the callback the app
# registers is <public-url>/api/v1/auth/oauth/github/callback. Unset, the login page draws
# no GitHub button and the endpoints answer 404.
# OXSUM_GITHUB_CLIENT_ID=Ov23li…
# OXSUM_GITHUB_CLIENT_SECRET=…
# Tests only: the provider's web and API origins, so a stub can stand in. The server
# defaults them to https://github.com and https://api.github.com.
# OXSUM_GITHUB_WEB_URL=
# OXSUM_GITHUB_API_URL=

# Anti-bot check on the two public account-creation endpoints — POST /api/v1/auth/register
# and /api/v1/invitations/redeem (issue #154). Cloudflare Turnstile: the site key is public
# (the page hands it to the widget), the secret authenticates the siteverify call. Both
# together or neither — a lone key refuses to boot. Unset, the endpoints run unchecked.
# OXSUM_TURNSTILE_SITE_KEY=0x…
# OXSUM_TURNSTILE_SECRET_KEY=0x…
# Tests only: the siteverify endpoint, default
# https://challenges.cloudflare.com/turnstile/v0/siteverify — a stub stands there.
# OXSUM_TURNSTILE_VERIFY_URL=

# The Stripe deposit rail (issue #201): card top-ups through a hosted Checkout page.
# All three together or none — a subset is a startup error, because a half-configured
# rail only fails inside a request. Unset, the rail is absent: POST /api/v1/topups/stripe
# answers 503 and the inbound webhook 404.
# OXSUM_STRIPE_SECRET_KEY is the API key the checkout-session POST authenticates with
# (sk_live_…/sk_test_…); OXSUM_STRIPE_WEBHOOK_SECRET (whsec_…) verifies the
# Stripe-Signature header on /api/v1/webhooks/stripe — the endpoint Stripe's dashboard
# registers is <public-url>/api/v1/webhooks/stripe, and OXSUM_PUBLIC_URL also roots the
# checkout success/cancel redirects. Keep both secrets out of logs the way
# OXSUM_SECRET_KEY is kept.
# OXSUM_STRIPE_SECRET_KEY=sk_test_…
# OXSUM_STRIPE_WEBHOOK_SECRET=whsec_…
# Tests only: the Stripe API origin the checkout-session POST goes to, default
# https://api.stripe.com — a stub stands there.
# OXSUM_STRIPE_API_URL=

# The Airwallex deposit rail (issue #285): card and APAC-method top-ups through
# the hosted payment page. All four together or none — a subset is a startup
# error, because a half-configured rail only fails inside a request. Unset, the
# rail is absent: POST /api/v1/topups/airwallex answers 503 and the inbound
# webhook 404.
# OXSUM_AIRWALLEX_CLIENT_ID and OXSUM_AIRWALLEX_API_KEY are the web-app
# Developer key pair — exchanged for a short-lived bearer token at
# /api/v1/authentication/login when a PaymentIntent is created.
# OXSUM_AIRWALLEX_WEBHOOK_SECRET verifies the x-signature header (HMAC-SHA256 of
# `x-timestamp + body`) on /api/v1/webhooks/airwallex — the endpoint Airwallex's
# web app registers is <public-url>/api/v1/webhooks/airwallex, and
# OXSUM_PUBLIC_URL also roots the intent's return_url. Keep the secrets out of
# logs the way OXSUM_SECRET_KEY is kept.
# OXSUM_AIRWALLEX_CLIENT_ID=
# OXSUM_AIRWALLEX_API_KEY=
# OXSUM_AIRWALLEX_WEBHOOK_SECRET=
# Tests only: the API and hosted-page origins the intent POST and redirect go
# to, defaults https://api.airwallex.com and https://checkout.airwallex.com —
# a stub stands there.
# OXSUM_AIRWALLEX_API_URL=
# OXSUM_AIRWALLEX_CHECKOUT_URL=

# The Hyperswitch deposit rail (issue #319): the switch in front of the
# processors. All three together or none — a subset is a startup error, because
# a half-configured rail only fails inside a request. Unset, the rail is absent:
# POST /api/v1/topups/hyperswitch answers 503 and the inbound webhook 404.
# OXSUM_HYPERSWITCH_API_KEY is the business profile's API key (snd_…/live_…),
# sent as the `api-key` header to POST /payments.
# OXSUM_HYPERSWITCH_WEBHOOK_SECRET is the profile's payment_response_hash_key:
# it verifies X-Webhook-Signature-512 (hex HMAC-SHA512 over the raw body) on
# /api/v1/webhooks/hyperswitch — the endpoint the Control Center registers is
# <public-url>/api/v1/webhooks/hyperswitch, and OXSUM_PUBLIC_URL also roots the
# payment's return_url.
# OXSUM_HYPERSWITCH_PUBLISHABLE_KEY (pk_snd_…/pk_live_…) is what the browser
# SDK initializes with; it never authenticates a server call. Keep the first two
# out of logs the way OXSUM_SECRET_KEY is kept.
# OXSUM_HYPERSWITCH_API_KEY=
# OXSUM_HYPERSWITCH_WEBHOOK_SECRET=
# OXSUM_HYPERSWITCH_PUBLISHABLE_KEY=
# The switch origin: the hosted sandbox by default. A local sidecar — the
# recommended dev path, see docs/development.md "Hyperswitch sidecar" — answers
# at http://localhost:8080; a self-hosted deployment points it at its own app
# server; a test stands a stub there.
# OXSUM_HYPERSWITCH_BASE_URL=http://localhost:8080

# The x402 deposit rail (issues #264, #282): signed payment authorizations
# credited through POST /api/v1/topups/x402. Two configurations, either or
# neither — the facilitator set wins when complete:
#
# **The real rail** delegates verify/settle to an x402-rs facilitator sidecar
# (`ghcr.io/x402-rs/x402-facilitator`, or the hosted facilitator.x402.rs). All
# four or none; a subset is a startup error. `NETWORK` is the V1 chain name
# (base-sepolia for tests, base for production); `ASSET` is the chain token
# contract the deployment accepts (USDC on base-sepolia:
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e); `PAY_TO` is the address payments
# must name as `to` — the deployment's own receiving wallet.
# OXSUM_X402_FACILITATOR_URL=http://localhost:8080
# OXSUM_X402_NETWORK=base-sepolia
# OXSUM_X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# OXSUM_X402_PAY_TO=0x…
#
# **The stand-in** pins the payer key the test-scheme verifier trusts — the
# hex Ed25519 public key authorization signatures are checked against. Only
# when the facilitator set is absent; ignored when it is present. Unset both
# and the rail is absent: the endpoint answers 503.
# OXSUM_X402_VERIFYING_KEY=

# Log level, using tracing-subscriber's EnvFilter syntax. The same filter applies to
# exported traces when OXSUM_OTLP_ENDPOINT is set — RUST_LOG quiets both.
RUST_LOG=info

# OTLP trace export (issue #224): the collector's HTTP endpoint, e.g.
# http://localhost:4318 — the exporter appends /v1/traces. Unset, tracing stays
# strictly local and the feature costs nothing. Spans carry only the GenAI
# semantic-convention vocabulary (operation, system, model, token counts) —
# never a request id, organization, or key.
# OXSUM_OTLP_ENDPOINT=http://localhost:4318

# Tests only: how many generated sequences the generative wallet test runs (default 1000, which
# is what CI is asked for). Commented out because the server never reads it.
# PROPTEST_CASES=1000

# Tests only: opt the real-provider end-to-end test (crates/server/tests/real_upstream.rs)
# into reaching a real provider — all three together, or the test skips. Keep the key out
# of this file in practice; pass it in the shell environment for the one run.
# OXSUM_E2E_UPSTREAM_BASE_URL=
# OXSUM_E2E_UPSTREAM_API_KEY=
# OXSUM_E2E_MODEL=

# Display currency (issue #257): the deployment-wide fiat unit an organization renders
# its credits in when the organization itself declares none — a default, never a charge
# input. The ledger keeps integer minor units either way; this only changes what the
# dashboard, the bills exports and the statement PDF print beside the credits figure.
# Code and rate together or neither — a lone half is a startup error.
# The ISO 4217 code:
# OXSUM_DISPLAY_CURRENCY=USD
# How many of the unit one credit displays as, as a decimal literal (never a float):
# OXSUM_DISPLAY_RATE_PER_CREDIT=0.0014
# Optional: the decimals the render rounds half-up to (0–6, default 2):
# OXSUM_DISPLAY_DECIMALS=2
